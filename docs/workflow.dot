digraph workflow {
  graph [rankdir=TB, fontname="Helvetica", fontsize=12, nodesep=0.5, ranksep=0.6, pad=0.3, bgcolor="white",
         label="Workflow: from the business problem to a decision (each step feeds the next)", labelloc=t, labeljust=l, fontcolor="#17212b"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, color="#9aa7b3", fillcolor="white", fontcolor="#17212b", width=1.9, margin="0.12,0.08"];
  edge [color="#5b6875", arrowsize=0.7, fontname="Helvetica", fontsize=8, fontcolor="#5b6875"];

  p  [label="1  PROBLEM\nManagers can't see how the\nmarket is trending, so bank\nperformance can't be judged\nagainst it", fillcolor="#fbe4e2"];
  q  [label="2  QUESTION\nHow has market activity\ntrended over 90 days, and is\nthere anything to watch?"];
  d  [label="3  DATA\nRBA cash rate (macro)\nS&P/ASX 200 (market)\nboth Sydney-based", fillcolor="#d8e9ed"];
  pl [label="4  PIPELINE\nscheduled fetch → raw kept\n→ validate → quarantine\nbad rows with a reason", fillcolor="#d8e9ed"];
  m  [label="5  METRICS\n20-day avg volume\n14-day volatility\n20-day rate of change", fillcolor="#d8e9ed"];
  r  [label="6  RELATE 3 SERIES\nindex ↔ volatility\ncash rate ↔ index\ncash rate ↔ volatility", fillcolor="#d8e9ed"];
  db [label="7  DASHBOARD\nheadline + RAG signal\n3 charts on one time axis", fillcolor="#e3f3e9"];
  e  [label="8  EFFECT\nGREEN: benchmark as usual\nAMBER: watch 2 weeks\nRED: caution + brief desk", fillcolor="#e3f3e9"];

  {rank=same; p; q; d; pl;}
  {rank=same; m; r; db; e;}
  p -> q -> d -> pl;
  pl -> m;
  m -> r -> db -> e;
  e -> p [label="review thresholds\nquarterly", style=dashed];
  ai [label="AI agent at steps 4–7:  plain-language requirement (prompt)  →  agent generates code  →  check against hand-worked numbers  →  log mistakes",
      shape=note, fillcolor="#fdf0d5", color="#d4a84a"];
  e -> ai [style=invis];
}
